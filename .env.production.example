# Production — Hetzner VPS — used with docker-compose.production.yml.
# Copy only to /etc/settlr/production.env on the VPS (root:root, mode 0600).
# Do not copy staging values, volumes, database data, JWTs, or Brevo credentials.
POSTGRES_USER=settlr
POSTGRES_PASSWORD=replace-with-a-random-value
POSTGRES_DB=settlr
DATABASE_URL=postgres://settlr:replace-with-a-random-value@postgres:5432/settlr?sslmode=disable
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-at-least-32-random-characters
APP_URL=https://example.com
API_URL=https://api.example.com
PORT=8080
APP_ENV=production
CORS_ORIGINS=https://example.com
# Use a pinned Docker Hub digest, never a mutable tag.
API_IMAGE=ghcr.io/settlr-org/settlr-api@sha256:replace-with-release-digest
# Set true only when the API port is reachable exclusively through a trusted reverse proxy.
TRUST_PROXY_HEADERS=true
# Comma-separated allow-list of Google web, iOS and Android OAuth client IDs.
GOOGLE_OAUTH_CLIENT_IDS=replace-with-google-web-ios-and-android-client-ids

# Email — create a production-only Brevo credential.
MAIL_PROVIDER=brevo
BREVO_API_KEY=inject-at-runtime
MAIL_FROM_EMAIL=mail@example.com
MAIL_FROM_NAME=Settlr
# SMTP_HOST= (only if MAIL_PROVIDER=smtp)
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
