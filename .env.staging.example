# Staging — current machine (Tailscale) — used with docker-compose.staging.yml or base docker-compose.yml
# Copy to staging host as .env (never commit real secrets). Staging is strict like production.
POSTGRES_USER=settlr
POSTGRES_PASSWORD=replace-with-a-random-value
POSTGRES_DB=settlr
DATABASE_URL=postgres://settlr:replace-with-a-random-value@postgres:5432/settlr?sslmode=disable
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-at-least-32-random-characters
APP_URL=https://settlr-staging.vercel.app
API_URL=https://settlrstagingapi.theswissknife.com
PORT=8080
APP_ENV=staging
CORS_ORIGINS=https://settlr-staging.vercel.app,https://settlrstagingapi.theswissknife.com,https://arch.tailbd5522.ts.net
# Set true only when the API port is reachable exclusively through a trusted reverse proxy.
TRUST_PROXY_HEADERS=false
GOOGLE_OAUTH_CLIENT_IDS=replace-with-google-web-ios-and-android-client-ids

# Email — Brevo for staging (or leave empty for smtp fallback)
MAIL_PROVIDER=brevo
BREVO_API_KEY=inject-at-runtime
MAIL_FROM_EMAIL=noreply@settlr.app
MAIL_FROM_NAME=Settlr
# SMTP_HOST= (only if MAIL_PROVIDER=smtp)
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
