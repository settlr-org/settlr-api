DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/DB?sslmode=disable
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-at-least-32-random-characters
APP_URL=http://localhost:8081
API_URL=http://localhost:8080
PORT=8080
APP_ENV=development

# Email (Brevo recommended for production; falls back to SMTP, then log-only)
# MAIL_PROVIDER=brevo        # brevo | smtp | log (empty = auto-detect)
# BREVO_API_KEY=inject-at-runtime
# MAIL_FROM_EMAIL=noreply@yourdomain.com
# MAIL_FROM_NAME=Settlr
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=...
# SMTP_PASS=...
