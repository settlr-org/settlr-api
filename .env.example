# Local development — used with docker-compose.local.yml (Mailpit)
# Copy to .env and adjust secrets for local use
POSTGRES_USER=settlr
POSTGRES_PASSWORD=local-dev-password
POSTGRES_DB=settlr_local
DATABASE_URL=postgres://settlr:local-dev-password@postgres:5432/settlr_local?sslmode=disable
JWT_SECRET=local-dev-jwt-secret-0123456789abcdef-CHANGE-ME-32CHARS
JWT_REFRESH_SECRET=local-dev-refresh-secret-0123456789abcdef-CHANGE-ME-32CHARS
APP_URL=http://localhost:3000
API_URL=http://localhost:18080
PORT=8080
APP_ENV=development
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:19006,http://127.0.0.1:3000,http://127.0.0.1:19006

# Email — local uses Mailpit (smtp -> mailpit:1025, UI at http://localhost:8025)
MAIL_PROVIDER=smtp
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM_EMAIL=noreply@localhost
MAIL_FROM_NAME=Settlr
# BREVO_API_KEY= (not used in local)
