# Copy to /etc/settlr/production.env; keep root:root and chmod 0600.
# Every value below must be newly generated for this VPS. Never reuse staging.
POSTGRES_USER=settlr
POSTGRES_PASSWORD=replace-with-a-new-random-password
POSTGRES_DB=settlr
DATABASE_URL=postgres://settlr:replace-with-a-new-random-password@postgres:5432/settlr?sslmode=disable
JWT_SECRET=replace-with-at-least-32-new-random-characters
JWT_REFRESH_SECRET=replace-with-at-least-32-new-random-characters
APP_ENV=production
APP_URL=https://settlr.theswissknife.com
API_URL=https://settlrapi.theswissknife.com
CORS_ORIGINS=https://settlr.theswissknife.com
TRUST_PROXY_HEADERS=true
API_IMAGE=docker.io/nabinkhanal688/settlr-api@sha256:replace-with-a-staging-approved-digest

# Use a production-only Brevo credential.
MAIL_PROVIDER=brevo
BREVO_API_KEY=replace-with-production-only-brevo-key
MAIL_FROM_EMAIL=noreply@settlr.app
MAIL_FROM_NAME=Settlr

# Public age recipient used by the backup job. Its private key must be held
# outside this VPS to make a restore possible.
BACKUP_AGE_RECIPIENT=age1replace-with-your-off-vps-public-recipient
