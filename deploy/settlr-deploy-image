#!/usr/bin/env bash
# Deploy a published settlr-api image digest to this host (myserver).
# Installed root-owned at /usr/local/sbin/settlr-deploy-image and run via a narrow sudoers rule:
#   sudo -n /usr/local/sbin/settlr-deploy-image docker.io/<user>/settlr-api@sha256:<digest>
# Retags the digest as settlr-api:latest (the image the compose project already uses), recreates
# only the api service, waits for /readyz and rolls back to the previous image if it never gets ready.
set -euo pipefail

IMAGE="${1:-}"
PROJECT_DIR="${SETTLR_PROJECT_DIR:-/opt/settlr}"
ENV_FILE="${SETTLR_ENV_FILE:-/etc/settlr/production.env}"
READY_URL="${SETTLR_READY_URL:-http://127.0.0.1:18080/readyz}"
LOCAL_TAG="settlr-api:latest"
LOG="${SETTLR_DEPLOY_LOG:-/var/log/settlr-deploy.log}"

log() { printf '%s %s\n' "$(date -u +%FT%TZ)" "$*" | tee -a "$LOG" >&2; }

# Only immutable digests from the one repository pinned at install time are accepted.
ALLOWED_REPO="$(cat "${SETTLR_ALLOWED_REPO_FILE:-/etc/settlr/deploy-image-repo}" 2>/dev/null || true)"
if [ -z "$ALLOWED_REPO" ] || ! [[ "$IMAGE" =~ ^${ALLOWED_REPO//./\\.}@sha256:[0-9a-f]{64}$ ]]; then
  echo "usage: settlr-deploy-image ${ALLOWED_REPO:-<pinned repo>}@sha256:<64 hex>" >&2
  exit 2
fi

exec 9>/run/settlr-deploy.lock
flock -w 600 9 || { echo "another deploy is running" >&2; exit 3; }

compose() {
  docker compose -p settlr --project-directory "$PROJECT_DIR" \
    -f "$PROJECT_DIR/docker-compose.yml" -f "$PROJECT_DIR/docker-compose.override.yml" \
    --env-file "$ENV_FILE" "$@"
}

wait_ready() {
  for _ in $(seq 1 45); do
    if curl -fsS --max-time 3 "$READY_URL" >/dev/null 2>&1; then return 0; fi
    sleep 2
  done
  return 1
}

previous="$(docker image inspect --format '{{.Id}}' "$LOCAL_TAG" 2>/dev/null || true)"
log "deploying $IMAGE (previous ${previous:-none})"
docker pull --quiet "$IMAGE" >/dev/null
docker tag "$IMAGE" "$LOCAL_TAG"
compose up -d --no-build --no-deps api

if wait_ready; then
  log "ready: $IMAGE"
  exit 0
fi

log "not ready after deploy of $IMAGE; rolling back"
if [ -n "$previous" ]; then
  docker tag "$previous" "$LOCAL_TAG"
  compose up -d --no-build --no-deps api
  if wait_ready; then log "rolled back to $previous"; else log "ROLLBACK ALSO NOT READY"; fi
fi
exit 1
