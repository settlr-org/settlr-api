#!/usr/bin/env bash
# Forced command for the CI deploy key (authorized_keys: restrict,command="…/settlr-deploy-ssh").
# Allows exactly one thing: running settlr-deploy with a single commit-sha argument.
set -euo pipefail
cmd="${SSH_ORIGINAL_COMMAND:-}"
re="^sudo -n /usr/local/sbin/settlr-deploy ([0-9a-f]{40})$"
if [[ "$cmd" =~ $re ]]; then
  exec sudo -n /usr/local/sbin/settlr-deploy "${BASH_REMATCH[1]}"
fi
echo "settlr-deploy-ssh: command not allowed" >&2
exit 1
