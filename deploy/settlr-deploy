#!/usr/bin/env bash
# Deploy a commit of settlr-api to this host (myserver). Installed root-owned at
# /usr/local/sbin/settlr-deploy and run via a narrow sudoers rule:
#   sudo -n /usr/local/sbin/settlr-deploy <40-hex commit sha>
# The commit must already be on origin/main. Builds the image from source in /opt/settlr (the
# repo is public, so no registry credentials are needed), recreates only the api service,
# waits for /readyz and rolls back to the previous commit + image if it never becomes ready.
set -euo pipefail

SHA="${1:-}"
PROJECT_DIR="${SETTLR_PROJECT_DIR:-/opt/settlr}"
ENV_FILE="${SETTLR_ENV_FILE:-/etc/settlr/production.env}"
READY_URL="${SETTLR_READY_URL:-http://127.0.0.1:18080/readyz}"
LOG="${SETTLR_DEPLOY_LOG:-/var/log/settlr-deploy.log}"

log() { printf '%s %s\n' "$(date -u +%FT%TZ)" "$*" | tee -a "$LOG" >&2; }

if ! [[ "$SHA" =~ ^[0-9a-f]{40}$ ]]; then
  echo "usage: settlr-deploy <40-hex commit sha on origin/main>" >&2
  exit 2
fi

exec 9>/run/settlr-deploy.lock
flock -w 900 9 || { echo "another deploy is running" >&2; exit 3; }

git_() { git -c safe.directory="$PROJECT_DIR" -C "$PROJECT_DIR" "$@"; }
compose() {
  docker compose -p settlr --project-directory "$PROJECT_DIR" \
    -f "$PROJECT_DIR/docker-compose.yml" -f "$PROJECT_DIR/docker-compose.override.yml" \
    --env-file "$ENV_FILE" "$@"
}
wait_ready() {
  for _ in $(seq 1 45); do
    curl -fsS --max-time 3 "$READY_URL" >/dev/null 2>&1 && return 0
    sleep 2
  done
  return 1
}

git_ fetch --quiet origin main
if ! git_ merge-base --is-ancestor "$SHA" origin/main; then
  echo "refusing: $SHA is not on origin/main" >&2
  exit 4
fi

prev_sha="$(git_ rev-parse HEAD)"
prev_image="$(docker image inspect --format '{{.Id}}' settlr-api:latest 2>/dev/null || true)"
log "deploying $SHA (previous $prev_sha)"
git_ checkout --quiet --detach "$SHA"
if compose build api && compose up -d --no-deps api && wait_ready; then
  log "ready: $SHA"
  exit 0
fi

log "deploy of $SHA failed or never became ready; rolling back to $prev_sha"
git_ checkout --quiet --detach "$prev_sha"
if [ -n "$prev_image" ]; then docker tag "$prev_image" settlr-api:latest; fi
compose up -d --no-build --no-deps api
if wait_ready; then log "rolled back to $prev_sha"; else log "ROLLBACK ALSO NOT READY"; fi
exit 1
